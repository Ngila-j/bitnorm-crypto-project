# Copy to .env and fill in values. Never commit .env.

# --- Exchange integration (Phase 4+) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_BASE_URL=https://api.your-exchange.com
EXCHANGE_MODE=mock
# EXCHANGE_MODE=mock  → simulated prices/books (safe default)
# EXCHANGE_MODE=live  → real REST calls when keys are set

# --- Optional public market data ---
COINGECKO_ENABLED=true

# --- App ---
BN_ENV=development
# BN_ENV=staging | production
BN_API_HOST=0.0.0.0
BN_API_PORT=8000